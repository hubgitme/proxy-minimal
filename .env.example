# .env.example — کپی کن به .env و خودت پرش کن. هیچ کلیدی در کار نیست.
# برای هر پروایدر فقط یک خط: اسم را خودت انتخاب کن، بعد آدرسش را بنویس.
# مسیر می‌شود: /<name کوچک‌شده>/*
#
# مثال — پروایدر اول:
GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# مثال — پروایدر دوم:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# مثال — پروایدر سوم:
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
#
# هر چند پروایدر که بخواهی؛ برای حذف، همان خط را بردار و ری‌استارت کن.
